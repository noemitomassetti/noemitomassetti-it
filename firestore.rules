// SITE PUBBLICO: nessun accesso diretto a Firestore richiesto dal frontend.
// NON applicare queste regole al progetto Firestore privato NoeTom: le due app
// devono avere policy e database/permessi verificati separatamente.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
