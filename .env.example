# Static public site. No NoeTom API is deployed by this package.
# Leave unset until a separately deployed backend passes persistence/security tests.
# VITE_API_BASE_URL=https://api.example.org
# Never place server secrets or login credentials in VITE_* variables.

# Web3Forms public form identifier; recipients are selected in its dashboard.
# If unset, src/lib/api/web3formsPublicConfig.ts supplies the preview form identifier.
# Explicitly set to an empty string to disable Web3Forms in a test build.
# VITE_WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Production release requires real delivery to info@noemitomassetti.it.

# Legacy FormSubmit is disabled by default. Never enable it as automatic failover.
VITE_LEGACY_FORMSUBMIT_ENABLED=false
# Professional address only; changing this does not change Web3Forms recipients.
# VITE_FORM_RECIPIENT_EMAIL=info@noemitomassetti.it
