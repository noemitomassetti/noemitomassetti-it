# Public site builds are static on Vercel; no NoeTom API is deployed by this package.
# Leave UNSET to use only the FormSubmit email provider after its recipient activation is verified.
# Future: HTTPS origin of a separately deployed, tested, privacy-reviewed NoeTom backend.
# VITE_API_BASE_URL=https://api.example.org
# Do not put API keys or server credentials in any VITE_ variable.

# FormSubmit recipient: leave unset to keep the existing Gmail destination until verified.
# After activating/confirming FormSubmit on the professional mailbox and testing delivery:
# VITE_FORM_RECIPIENT_EMAIL=info@noemitomassetti.it
# This public value MUST NOT contain any password or API secret.
