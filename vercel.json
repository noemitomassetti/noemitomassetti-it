      "source": "/it/esempi-di-lavoro",
      "destination": "/it/esempi-di-lavoro/index.html"
    },
    {
      "source": "/fr/exemples-de-projets",
      "destination": "/fr/exemples-de-projets/index.html"
    },
    {
      "source": "/es/ejemplos-de-trabajo",
      "destination": "/es/ejemplos-de-trabajo/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
